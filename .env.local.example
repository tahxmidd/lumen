# ── Local development ─────────────────────────────────────────────
# 1. Copy this file:  cp .env.local.example .env.local
# 2. Add your Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: OCR for photos and scanned PDFs (https://www.nutrient.io/api/data-extraction-api/).
# With this set, photo quotes become machine-verifiable against the OCR transcription.
# Without it, photos fall back to Gemini's built-in vision.
NUTRIENT_API_KEY=

# ── Vercel (live / production) ────────────────────────────────────
# Do NOT commit .env.local. Set secrets in the Vercel dashboard instead:
#   Project → Settings → Environment Variables → GEMINI_API_KEY
# Apply to Production, Preview, and Development, then redeploy.
